{
  "id": "/",
  "name": "CrewOne HR",
  "short_name": "CrewOne",
  "description": "Manage your team, attendance, leaves and payroll in one place.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#f5f6fa",
  "theme_color": "#4f46e5",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/api/pwa-icon?size=192",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/api/pwa-icon?size=512",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/api/pwa-icon?size=512&m=1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "icons": [{ "src": "/api/pwa-icon?size=96", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Chat",
      "short_name": "Chat",
      "url": "/chat",
      "icons": [{ "src": "/api/pwa-icon?size=96", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "My Leaves",
      "short_name": "Leaves",
      "url": "/dashboard#leaves",
      "icons": [{ "src": "/api/pwa-icon?size=96", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
